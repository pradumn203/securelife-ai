# Groq — get a free-tier key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# One model per agent. On the free tier each model has its own 8000
# tokens-per-minute bucket, so agents are spread across three models:
#   Chat agent              → Qwen: natural prose, no hidden reasoning, streams cleanly.
#   Chat extractor agent    → gpt-oss-20b: runs every turn, kept off the chat bucket.
#   Qualification agent     → gpt-oss-20b: structured judgment over the transcript.
#   Document extractor agent→ gpt-oss-120b: hardest task, long messy policy text.
#   Analysis agent          → Qwen: broker-voice synthesis; off the extraction bucket
#                             because analysis usually runs right after extraction.
GROQ_MODEL_CHAT=qwen/qwen3.8-27b
GROQ_MODEL_CHAT_EXTRACTOR=openai/gpt-oss-20b
GROQ_MODEL_QUALIFICATION=openai/gpt-oss-20b
GROQ_MODEL_EXTRACTION=openai/gpt-oss-120b
GROQ_MODEL_ANALYSIS=qwen/qwen3.8-27b

# If an agent's model is rate-limited (per-minute or per-day quota), the call
# moves down this list. Each free-tier model has its own 200k tokens/day.
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# Timeouts (seconds)
GROQ_TIMEOUT_CHAT=60
GROQ_TIMEOUT_QUALIFICATION=60
GROQ_TIMEOUT_EXTRACTION=120
GROQ_TIMEOUT_ANALYSIS=60

# SDK retry budget (how many times to retry a request on transient 5xx/429)
GROQ_MAX_RETRIES=3

# Per-agent output-token caps. Groq can reject a request outright (429) when
# its max_tokens exceeds your org's output-tokens-per-minute limit — 1000 on
# the free tier — so keep every cap below it. Raise these on a paid tier.
GROQ_MAX_TOKENS_CHAT=400
GROQ_MAX_TOKENS_CHAT_EXTRACTOR=400
GROQ_MAX_TOKENS_QUALIFICATION=900
GROQ_MAX_TOKENS_EXTRACTION=900
GROQ_MAX_TOKENS_ANALYSIS=900

# PDF text budget per extraction call (characters). Groq counts prompt +
# max_tokens against tokens-per-minute (8000 per model on the free tier).
GROQ_EXTRACTION_MAX_INPUT_CHARS=18000

# Qualification agent: QUALIFIED needs an overall score (0-100) >= this.
QUALIFICATION_THRESHOLD=70
# A hedged NEEDS_MORE_INFO becomes NOT_QUALIFIED below this score when red flags exist.
QUALIFICATION_REJECT_BELOW=45

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/securelife.db
UPLOAD_DIR=./data/uploads

# CORS (comma-separated); include your Vite dev origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Logging
LOG_LEVEL=INFO
